# --- Server ---
PORT=3000

# --- Database ---
# PostgreSQL connection string.
DATABASE_URL=

# --- Cache and shared rate budgets (Upstash Redis) ---
# Optional, but both or neither — a URL without a token refuses to boot. These are the
# REST credentials, not the rediss:// connection string: Upstash console -> your database
# -> "REST API". Blank runs with no cache and no shared budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- HTTP ---
# Comma-separated browser origins allowed to send credentialed requests. Blank allows any
# origin, which is fine in development; set it in production. The mobile app sends no
# Origin header and is unaffected either way.
CORS_ORIGINS=
# How long a request may run before the client is answered 503. The work itself finishes.
REQUEST_TIMEOUT_MS=45000
# Proxy hops to trust when reading the client address. 0 uses the socket address, which is
# right when this API is exposed directly. Behind a proxy, set it to the number of hops —
# too low and every caller shares one rate-limit bucket, too high and any caller can forge
# a fresh identity per request.
TRUST_PROXY=0

# --- Auth ---
# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The URL this API is reachable at, and the base of the Google redirect URI.
BETTER_AUTH_URL=http://localhost:3000
# Optional. Blank leaves email sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM (meal parsing) ---
# Provider root, without /chat/completions. The key and the model id belong to it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# --- Food database ---
# Free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# --- Open Food Facts ---
# Open Food Facts has no API key: none of the three below are needed to run.
# Set OFF_ENABLED=false to switch the provider off and run on USDA alone.
OFF_ENABLED=true
OFF_BASE_URL=https://search.openfoodfacts.org
# How the app identifies itself to Open Food Facts. An app name and version, optionally a
# project URL. Never a personal email address.
OFF_USER_AGENT=Viora/1.0
