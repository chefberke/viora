PORT=3000

# PostgreSQL connection string.
#   Local:  postgres://postgres:postgres@localhost:5432/viora
#   Hosted: a Neon or Supabase URL works too — append ?sslmode=require
DATABASE_URL=

# Signs every session cookie. Generate one with: openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=

# The URL this API is reachable at. It must match the origin the phone or simulator
# calls, and it is the base of the Google redirect URI below.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Google Cloud Console -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#
# Google only accepts https:// redirect URIs, with http://localhost as the one exception,
# so "Continue with Google" works on the iOS Simulator but needs an https tunnel
# (cloudflared / ngrok) to work on a physical phone. Leave these blank to run with
# email sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
