# Where the API is reachable FROM THE DEVICE that runs the app — not from your Mac.
#   iOS Simulator     http://localhost:3000
#   Android Emulator  http://10.0.2.2:3000
#   Physical device   http://<your-mac-LAN-IP>:3000
#
# Expo inlines EXPO_PUBLIC_* at bundle time, so restart Metro after changing this.
EXPO_PUBLIC_API_URL=http://localhost:3000
