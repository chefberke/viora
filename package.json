{
  "name": "viora",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "mobile": "npm run start --workspace=@viora/mobile",
    "api": "npm run dev --workspace=@viora/api"
  },
  "devDependencies": {
    "turbo": "^2.10.10"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  }
}
